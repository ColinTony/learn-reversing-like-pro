# Laboratorio i386 aislado. Ejecutar desde Contenedores/.
Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("REVERSING_BOX", "generic/debian12")
  if config.vm.box == "generic/debian12"
    config.vm.box_version = "4.3.12"
    config.vm.box_architecture = "i386"
  end
  config.vm.box_url = ENV["REVERSING_BOX_URL"] if ENV["REVERSING_BOX_URL"] && !ENV["REVERSING_BOX_URL"].empty?
  config.vm.box_check_update = false
  config.vm.hostname = "reversing-legacy32"
  config.vm.boot_timeout = 600
  config.ssh.forward_agent = false

  # rsync unidireccional del host al invitado, nunca SUID sobre carpeta compartida.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "..", "/workspace", type: "rsync",
    rsync__exclude: [".git/", ".vagrant/", "*.box", "*.qcow2", "*.vdi"]

  config.vm.provider "virtualbox" do |vb|
    vb.name = "reversing-legacy32"
    vb.memory = 2048
    vb.cpus = 2
    vb.gui = false
  end

  # NAT para provision/SSH; ningún servicio vulnerable se expone automáticamente.
  config.vm.provision "shell", path: "provision/01-base.sh"
  config.vm.provision "shell", path: "provision/02-exercises.sh"
  config.vm.provision "shell", path: "provision/03-radare2.sh" if ENV.fetch("REVERSING_INSTALL_R2", "1") == "1"
end
